# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (legacy/non-SRV format)
# Format: mongodb://user:pass@host1:27017,host2:27017,host3:27017/db?ssl=true&replicaSet=xxx&authSource=admin
MONGO_URI=replace-with-your-mongodb-atlas-connection-string

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend URL (used by server for CORS + Socket.io)
# Local: http://localhost:8080
# Production: your deployed Vercel URL, e.g. https://cgpa-booster.vercel.app
CLIENT_URL=http://localhost:8080

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
# Local: http://localhost:5000/api/auth/google/callback
# Production: your deployed Render URL, e.g. https://cgpa-booster-server.onrender.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Client build-time API URL (used by docker-compose when building the client image)
# Local: http://localhost:5000/api
# Production: your deployed Render URL + /api
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
